{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@codeteams/shared": ["./packages/shared/src/index.ts"],
      "@codeteams/storage": ["./packages/storage/src/index.ts"],
      "@codeteams/acp": ["./packages/acp/src/index.ts"],
      "@codeteams/engine": ["./packages/engine/src/index.ts"]
    }
  }
}
